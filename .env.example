PORT=3000

# === BASE DE DATOS ===
DB_USER=""
DB_PASSWORD=""
DB_SERVER=""
DB_DATABASE=""
DB_PORT=""

# Local / contenedor con TLS auto-firmado:
#   DB_ENCRYPT=false
#   DB_TRUST_CERT=true
#
# Produccion (Azure SQL, AWS RDS, SQL Server con TLS real):
#   DB_ENCRYPT=true
#   DB_TRUST_CERT=false
DB_ENCRYPT=""
DB_TRUST_CERT=""

# Pool (opcional - ajustar segun carga)
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_MS=30000

# === AUTH / JWT ===
# Firma del access token. En produccion usar un string aleatorio largo (>=32 chars).
JWT_ACCESS_SECRET=""
# Compatibilidad legacy. Puede dejarse igual a JWT_ACCESS_SECRET.
JWT_SECRET=""

# Vida del access token (formato ms): 15m, 1h, 7d, etc.
JWT_ACCESS_EXPIRATION=""

# Vida del refresh token en dias
REFRESH_TOKEN_EXPIRATION_DAYS=""

# === CLOUDINARY (si aplica) ===
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# === PUSH NOTIFICATIONS (API FCM externa) ===
# Base URL de la API que reenvia pushes a FCM. El backend hace POST {URL}/send.
# Ej. local: http://localhost:3005
# Ej. prod:  https://api.tudominio.com
PUSH_API_URL=""
# Timeout en ms para la llamada al servicio FCM (default 5000)
PUSH_TIMEOUT_MS="5000"

# === OTP (Task 7.1.B - recuperacion de contrasena server-side) ===
# URL del proveedor OTP (temporal hasta el servicio propio multicanal).
OTP_URL="https://api-otp.apps.isdapps.uk"
# Secreto/credencial del proveedor (si aplica). NUNCA versionar el valor real.
# La credencial OTP historicamente incrustada en Flutter debe rotarse (comprometida).
OTP_PASSWORD=""

# === API-ULV (Task 7.4A - fuente institucional de la cadena de autorizacion) ===
# Base URL unica que sirve /api/datos/* (alumno/work, prece, JefeDepto, coordinador).
# NO hardcodear hosts internos (172.16.30.10:3002) en el codigo.
ULV_API_URL="https://ulv-api.apps.isdapps.uk"
ULV_API_TIMEOUT_MS="8000"
