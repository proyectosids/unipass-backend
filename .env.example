PORT=3000

# === BASE DE DATOS ===
DB_USER=""
DB_PASSWORD=""
DB_SERVER=""
DB_DATABASE=""
DB_PORT=""

# Local / contenedor con TLS auto-firmado:
#   DB_ENCRYPT=false
#   DB_TRUST_CERT=true
#
# Produccion (Azure SQL, AWS RDS, SQL Server con TLS real):
#   DB_ENCRYPT=true
#   DB_TRUST_CERT=false
DB_ENCRYPT=""
DB_TRUST_CERT=""

# Pool (opcional - ajustar segun carga)
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_MS=30000

# === AUTH / JWT ===
# Firma del access token. En produccion usar un string aleatorio largo (>=32 chars).
JWT_ACCESS_SECRET=""
# Compatibilidad legacy. Puede dejarse igual a JWT_ACCESS_SECRET.
JWT_SECRET=""

# Vida del access token (formato ms): 15m, 1h, 7d, etc.
JWT_ACCESS_EXPIRATION=""

# Vida del refresh token en dias
REFRESH_TOKEN_EXPIRATION_DAYS=""

# === CLOUDINARY (si aplica) ===
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
