PORT=3000

DB_USER=sa
DB_PASSWORD=changeme
DB_SERVER=localhost
DB_DATABASE=UNIPASS

# Firma del access token (si no existe, fallback a JWT_SECRET)
JWT_ACCESS_SECRET=change_me_a_long_random_string

# Compatibilidad con codigo legacy. Puede dejarse igual a JWT_ACCESS_SECRET.
JWT_SECRET=change_me_a_long_random_string

# Vida del access token (formato ms / vercel/ms): 15m, 1h, 7d, etc.
JWT_ACCESS_EXPIRATION=15m

# Vida del refresh token en dias
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Cloudinary (si aplica)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
